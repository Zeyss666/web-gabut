# ============================================================
#  SocialPoster - contoh konfigurasi (SALIN ke file bernama .env)
# ============================================================

# --- Aplikasi ---
# Ganti SECRET_KEY dengan string acak panjang (untuk JWT).
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./socialposter.db
BASE_URL=http://localhost:8000
UPLOAD_DIR=./uploads

# --- Meta (Facebook + Instagram) ---
# Daftar & buat aplikasi di https://developers.facebook.com/apps
# Lalu aktifkan produk "Instagram Graph API" dan "Facebook Login".
# Isi App ID & App Secret dari dashboard aplikasi Meta kamu.
META_APP_ID=
META_APP_SECRET=

# --- TikTok ---
# Daftar & buat aplikasi di https://developers.tiktok.com/
# (Content Posting API perlu approval TikTok untuk bisa posting).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
